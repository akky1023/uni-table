**/key.properties
*.jks
*.keystore
*.p12
*.pfx
.env
.env.*
!.env.example

# User databases and device preferences
*.unitable
*.unitable-*
storage-location.json

# IDE / OS files
.idea/
*.iml
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
Desktop.ini

# Python cache and diagnostic logs
__pycache__/
*.py[cod]
*.log
